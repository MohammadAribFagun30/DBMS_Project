# Server Configuration
NODE_ENV=development
PORT=5050
APP_URL="http://localhost:5050"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/club_event_db?schema=public"

# Security Configuration
BCRYPT_SALT_ROUNDS=10

# JWT Configuration
JWT_ACCESS_SECRET="your_jwt_access_secret_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Email Configuration (Resend or Nodemailer SMTP)
# Option A: Resend API (Recommended)
RESEND_API_KEY=""
EMAIL_FROM="ClubVerse <onboarding@resend.dev>"

# Option B: Nodemailer SMTP (e.g., Gmail, Mailtrap, or University SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
